{
    "name": "tower-rpg",
    "version": "0.1.93",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build",
        "pretest": "node --import ./tests/register.mjs scripts/generateCombatSqlCatalog.ts && node scripts/buildCombatV2Migration.mjs",
        "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
        "balance:hunting": "node --import ./tests/register.mjs scripts/balance/huntingBalance.ts"
    },
    "dependencies": {
        "@malilion/block-ui-react": "0.6.1",
        "gsap": "^3.15.0",
        "react": "19.1.0",
        "react-dom": "19.1.0"
    },
    "devDependencies": {
        "@electric-sql/pglite": "0.5.8",
        "@types/react": "19.1.2",
        "@types/react-dom": "19.1.2",
        "typescript": "5.8.3",
        "vite": "6.4.3"
    }
}
