{
  "name": "tower-rpg",
  "version": "0.1.93",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "pretest": "node --import ./tests/register.mjs scripts/generateCombatSqlCatalog.ts && node scripts/buildCombatV2Migration.mjs",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "balance:hunting": "node --import ./tests/register.mjs scripts/balance/huntingBalance.ts",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android && node scripts/configure-android.mjs",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.6.0",
    "@malilion/block-ui-react": "0.6.1",
    "gsap": "^3.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
